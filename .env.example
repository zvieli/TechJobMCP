# FastMCP Transport Configuration
# Transport mode: stdio or sse (default: stdio)
MCP_TRANSPORT=stdio
# Host to bind the SSE server to (default: 127.0.0.1)
MCP_HOST=127.0.0.1
# Port to bind the SSE server to (default: 8000)
MCP_PORT=8000

# Playwright Browser Automation Configuration
# Directory to store persistent browser context and session cookies
BROWSER_PROFILE_DIR=./browser_profile
# Run browser in headless mode (true / false, default: true)
BROWSER_HEADLESS=true

# Caching Configuration
# Time-to-live for cached search results in minutes (default: 60)
CACHE_TTL_MINUTES=60

# Logging Configuration
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL (default: INFO)
LOG_LEVEL=INFO
