# FastMCP Transport Configuration
# Transport mode: stdio or sse (default: stdio)
MCP_TRANSPORT=http
# Host to bind the SSE server to (default: 127.0.0.1)
MCP_HOST=127.0.0.1
# Port to bind the SSE server to (default: 8000)
MCP_PORT=8000

# Playwright Browser Automation Configuration
# Directory to store persistent browser context and session cookies
BROWSER_PROFILE_DIR=./browser_profile
# Run browser in headless mode (true / false, default: true)
BROWSER_HEADLESS=true

# Candidate & CV Configuration
# Path to candidate CV / resume (.pdf, .docx, .txt)
DEFAULT_CV_PATH=./cv.pdf
# Candidate contact details for automated application forms
CANDIDATE_EMAIL=candidate@example.com
CANDIDATE_NAME="Alex Rivera"

# Resilient Free-Tier LLM Gateway Configuration
# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# OpenRouter Dual-Model Combo
OPENROUTER_API_KEY=
OPENROUTER_EXTRACTION_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_REASONING_MODEL=z-ai/glm-5.2:free
OPENROUTER_MODEL=z-ai/glm-5.2:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Local Ollama URL and model for zero-cost offline fallback
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3.2
# SQLite cache database path for screening questionnaires
LLM_CACHE_PATH=llm_cache.db


# Autonomous Application Engine & Safety Guardrails
# Master safety switch for autonomous application submission (fail-closed default: false)
AUTO_APPLY_ENABLED=false
# SQLite database path for application ledger audit log
APPLICATION_LEDGER_PATH=application_ledger.db
# Maximum allowed successful applications per day
MAX_DAILY_APPLICATIONS=20

# Telegram Notifier Configuration
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Caching & Job Tracking Configuration
# Time-to-live for cached search results in minutes (default: 60)
CACHE_TTL_MINUTES=60
# Path to SQLite database or JSON file for job deduplication tracking
JOB_TRACKER_PATH=job_tracker.json
# Timeout in seconds per source fetch (default: 12.0)
SOURCE_TIMEOUT_SECONDS=12.0

# Logging Configuration
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL (default: INFO)
LOG_LEVEL=INFO

# Public Cloudflare Tunnel URL (if using SSE remote tunnel)
MC_PUBLIC_BASE_URL=https://xxxxxxx.trycloudflare.com

